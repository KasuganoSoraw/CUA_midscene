# Copy to .env.local and fill in real values. .env.local is intentionally ignored by git.
CUA_DATA_ROOT=C:\path\to\gde-claw-data\cua
CUA_RECORDINGS_ROOT=C:\path\to\recorder-output

# 组件宿主提供一个已安装 cua-agent、cua-recorder 和 cua-record 的 Python。
# 源码开发不设置时，record 与 recorder 各自使用相邻工程的 .venv。
# CUA_PYTHON_EXECUTABLE=C:\path\to\component-python.exe

MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
MIDSCENE_MODEL_NAME=minimax-m3
MIDSCENE_MODEL_API_KEY=replace-me

# Required for Midscene computer use. Choose a value supported by Midscene.
# For Volcengine Ark visual models this is often doubao-vision. minimax-m3 may not be vision-capable.
MIDSCENE_MODEL_FAMILY=doubao-vision

MIDSCENE_PREFERRED_LANGUAGE=zh-CN
MIDSCENE_REPLANNING_CYCLE_LIMIT=10

# Python CUA Agent 的任务级模型。未设置前三项时会回退到对应 MIDSCENE_MODEL_*。
CUA_AGENT_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CUA_AGENT_MODEL_NAME=minimax-m3
CUA_AGENT_MODEL_API_KEY=replace-me
CUA_AGENT_MODEL_TIMEOUT_SECONDS=120
CUA_AGENT_MAX_TURNS=8

# 安装环境可覆盖；源码 Review 使用相邻 agent/.venv、服务进程 JavaScript Runtime 和 dist worker。
# CUA_AGENT_ROOT=C:\path\to\CUA\agent
# CUA_AGENT_PYTHON_EXECUTABLE=C:\path\to\python.exe
# CUA_AGENT_JS_RUNTIME_EXECUTABLE=C:\Program Files\nodejs\node.exe
# CUA_AGENT_RUNTIME_BRIDGE=C:\path\to\execution\dist\runtime-bridge\worker.js
