{
  "$comment": "CUA 持久化契约；由 TypeScript 核心通过 Ajv 在文件边界校验。",
  "additionalProperties": false,
  "properties": {
    "dryRun": {
      "title": "Dryrun",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finishedAt": {
      "format": "date-time",
      "title": "Finishedat",
      "type": "string"
    },
    "finalScreenshotPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalscreenshotpath"
    },
    "hybrid": {
      "additionalProperties": false,
      "properties": {
        "steps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "stepIndex": { "type": "integer", "minimum": 0 },
              "stepId": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["replayed", "recovered", "failed"] },
              "replayError": { "type": "string" },
              "recoveryResult": { "type": ["string", "null"] },
              "recoveryError": { "type": "string" }
            },
            "required": ["stepIndex", "stepId", "name", "status"],
            "type": "object"
          },
          "type": "array"
        },
        "recovery": {
          "additionalProperties": false,
          "properties": {
            "attempted": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "limit": { "type": "integer", "minimum": 0 },
            "steps": {
              "items": { "type": "string", "minLength": 1 },
              "type": "array"
            }
          },
          "required": ["attempted", "succeeded", "limit", "steps"],
          "type": "object"
        }
      },
      "required": ["steps", "recovery"],
      "type": "object"
    },
    "midsceneResult": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Midsceneresult"
    },
    "reportPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reportpath"
    },
    "schemaVersion": {
      "const": "0.2",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceYamlPath": {
      "title": "Sourceyamlpath",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "taskCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taskcount"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sourceYamlPath",
    "dryRun",
    "finishedAt"
  ],
  "title": "ExecutorResult",
  "type": "object"
}
