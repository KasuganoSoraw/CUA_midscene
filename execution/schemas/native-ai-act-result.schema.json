{
  "$comment": "原生 Midscene aiAct 执行结果；由 TypeScript 核心通过 Ajv 在文件边界校验。",
  "additionalProperties": false,
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    },
    "midsceneResult": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": "0.1",
      "type": "string"
    },
    "sourcePromptPath": {
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sourcePromptPath",
    "dryRun",
    "finishedAt"
  ],
  "title": "NativeAiActExecutorResult",
  "type": "object"
}
