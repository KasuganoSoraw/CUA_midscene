# 复制为仓库根 .env.local，并填入本机实际值。真实密钥不得提交。

# 用户任务、运行产物与原始录制目录
CUA_DATA_ROOT=C:\path\to\cua-data
CUA_RECORDINGS_ROOT=C:\path\to\recorder-output

# 执行历史按空间滚动清理；单位 MiB。0 禁用自动清理。
CUA_RUNS_MAX_MB=5120
# 未设置时清理至上限的 80%；显式设置不得超过上限。
# CUA_RUNS_TARGET_MB=4096
# 近期运行的最短保护时间，不是到期删除时间。
CUA_RUNS_MIN_AGE_HOURS=24

# Midscene computer use 模型
MIDSCENE_MODEL_BASE_URL=https://model-endpoint.example/v1
MIDSCENE_MODEL_NAME=vision-model
MIDSCENE_MODEL_API_KEY=replace-me
MIDSCENE_MODEL_FAMILY=doubao-vision
MIDSCENE_PREFERRED_LANGUAGE=zh-CN
MIDSCENE_REPLANNING_CYCLE_LIMIT=10

# Python CUA Agent 任务级模型；未设置专用 URL、名称或 Key 时使用对应 MIDSCENE_MODEL_*。
# API Key 可为空；显式设置空值时不发送 Bearer Authorization。
# CUA_AGENT_MODEL_BASE_URL=https://model-endpoint.example/v1
# CUA_AGENT_MODEL_NAME=agent-model
# CUA_AGENT_MODEL_API_KEY=replace-me
# 自定义请求头为 JSON object；可用于需要额外鉴权头的 OpenAI-compatible 端点。
# CUA_AGENT_MODEL_HEADERS={"X-Custom-Header":"value"}
CUA_AGENT_MODEL_TLS_VERIFY=true
CUA_AGENT_MODEL_TIMEOUT_SECONDS=120
CUA_AGENT_MAX_TURNS=8
# normal：自然语言执行和对话录制；professional：专业任务发现与 replay/guided/freeform。
# CUA_AGENT_TOOL_MODE=normal
# 兼容参数：true 等价于 normal；false 等价于 professional。显式 TOOL_MODE 优先。
CUA_AGENT_FREEFORM_ONLY=false
# Keeper 持有的本机录制服务根地址，不自动启动服务或打开网页。
# CUA_REVIEW_URL=http://127.0.0.1:47831/

# Record trace 模型覆盖；前三项留空时回退到对应 MIDSCENE_MODEL_*。
# OPENAI_BASE_URL=https://model-endpoint.example/v1
# OPENAI_MODEL=vision-model
# OPENAI_API_KEY=replace-me
OPENAI_VERIFY_SSL=true
ALOHA_TRACE_TEMPERATURE=0.2

# 组件 Host 提供统一 Python；源码开发留空时使用相邻 Python 工程的 .venv。
# CUA_PYTHON_EXECUTABLE=C:\path\to\component-python.exe

# Review --dev 和 Host 集成可显式覆盖的 Agent 运行路径。
# CUA_AGENT_ROOT=C:\path\to\CUA\agent
# CUA_AGENT_PYTHON_EXECUTABLE=C:\path\to\python.exe
# CUA_AGENT_JS_RUNTIME_EXECUTABLE=C:\Program Files\nodejs\node.exe
# CUA_AGENT_RUNTIME_BRIDGE=C:\path\to\execution\dist\runtime-bridge\worker.js
